# Template for .env.local (git-ignored): which servers `npx expo start` talks to, and the maps key.
#   cp .env.example .env.local
# Keep ONE server block uncommented, then start once with --clear:  npx expo start --clear
# (npm run start:local / start:test / start:prod pick the servers for one run without editing this file. Never put
#  *_OVERRIDE names here: they are what those scripts set.)

# ── Local: the stack on your Mac (costonomy-api's local/run.sh dev, with MP_API_REPO set) ──
# Phones and the Android emulator can't reach "localhost": use the Mac's Wi-Fi address (`ipconfig getifaddr en0`).
# Leave both lines commented to use the platform defaults (localhost on web and iOS, 10.0.2.2 on the Android emulator).
# EXPO_PUBLIC_API_URL=http://<your-mac-ip>:7070/costonomy-mp-api
# EXPO_PUBLIC_COMMON_API_URL=http://<your-mac-ip>:8082/costonomy-common-api

# ── Test: testapi.costonomy.com ──
# EXPO_PUBLIC_API_URL=https://testapi.costonomy.com/costonomy-mp-api
# EXPO_PUBLIC_COMMON_API_URL=https://testapi.costonomy.com/costonomy-common-api

# ── Production: api.costonomy.com (REAL customer data) ──
# EXPO_PUBLIC_API_URL=https://api.costonomy.com/costonomy-mp-api
# EXPO_PUBLIC_COMMON_API_URL=https://api.costonomy.com/costonomy-common-api

# Google Maps (docs/GOOGLE_MAPS.md)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
